# ─────────────────────────────────────────────────────────────────
# PredictiX Backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────

# ── Auth / JWT ──
JWT_SECRET=replace-with-a-random-uuid
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_PASSWORD="ChangeMe@123"

# ── Supabase ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PROJECT_REF=your-project-ref

# ── Database (Postgres / Supabase pooler) ──
# Password must be URL-encoded in the connection string.
DATABASE_KEY=your-db-secret-key
DATABASE_PASSWORD=your-db-password
DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@HOST:6543/postgres?sslmode=require

# ── Groq LLM (warehouse AI report) ──
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Model to use. Each model has its OWN daily token (TPD) quota, so switch here
# if one gets rate-limited. Alternatives: openai/gpt-oss-120b, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# ── Email: Brevo (primary email provider) ──
# Get an API key at https://app.brevo.com (SMTP & API > API Keys)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@predictix.lk
BREVO_SENDER_NAME=PredictiX System

# ── Email: SMTP fallback (used if Brevo/EmailJS not configured) ──
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
USE_TLS=true

# ── Email: EmailJS fallback (optional) ──
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Hugging Face (ML model repos) ──
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx
HF_TICKET_CATEGORIZATION_REPO=Dinusha-Ekanayake/predictix-ticket_categorization_model
HF_TICKET_SUMMARIZATION_REPO=Dinusha-Ekanayake/predictix-ticket_summarization_model
HF_TICKET_PRIORITIZATION_REPO=Dinusha-Ekanayake/predictix-ticket_prioritization_model
HF_ASSET_SUMMARIZATION_REPO=Dinusha-Ekanayake/predictix-asset_summarization_model
