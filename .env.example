# PredictiX API configuration template. Copy to .env and fill in; never commit .env.
# On the EC2 instance systemd reads /home/ubuntu/PredictiX_Backend/.env
# (chmod 600). docs/EC2_Deployment.md explains each production setting.

# ── Runtime ────────────────────────────────────────────────────────────────
# production: hides the API docs and drops the localhost CORS origins.
ENV=development
LOG_LEVEL=INFO
# true on exactly one host (the EC2 instance); false on dev machines and CI,
# which share the production database.
SCHEDULER_ENABLED=false
ENABLE_API_DOCS=
ENABLE_DEBUG_ROUTES=false

# ── Database and Supabase (required) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# The server's only Supabase key. Never put the public anon / publishable key
# here: the API refuses to use it, and production will not start without a
# server key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (required) ────────────────────────────────────────────────────────
# Long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# The API refuses to start without it; changing it signs everyone out.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=480

# ── CORS / links ───────────────────────────────────────────────────────────
# Extra frontend origins, comma-separated (the Vercel domains are built in).
ALLOWED_ORIGINS=
FRONTEND_URL=https://predicti-x-frontend.vercel.app
APP_URL=https://predicti-x-frontend.vercel.app

# ── LLMs ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=
CHATBOT_GROQ_API_KEY=
WH_GROQ_API_KEY=
# Optional model cascade, comma-separated (defaults in app/ai/services/llm_service.py).
GROQ_MODELS=
OPENROUTER_API_KEY=

# ── Hugging Face (ticket/asset models run on private Spaces) ───────────────
HF_TOKEN=
HF_TOKEN_space=
HF_AI_SPACE_URL=
TICKET_SUMMARY_SPACE=
ASSET_SUMMARY_SPACE=
HF_INFERENCE_API_URL=
HF_HUB_OFFLINE=0
# true skips local model warm-up; the Spaces are still called.
DISABLE_HF_MODELS=true
# Wake the Hugging Face Spaces this often (hours); 0 disables. They sleep after 48 h.
HF_SPACE_KEEPALIVE_HOURS=6

# ── Knowledge base ─────────────────────────────────────────────────────────
# Leave unset: detected automatically (off where sentence-transformers is absent).
KB_REFRESH_ENABLED=
KB_REFRESH_HOUR=2

# ── Scheduled jobs ─────────────────────────────────────────────────────────
BATCH_INTERVAL_HOURS=24
BATCH_RUN_ON_STARTUP=false
SERVICE_REMINDER_HOUR=9
SERVICE_REMINDER_TZ=Asia/Colombo
SERVICE_REMINDER_RUN_ON_STARTUP=false

# ── Email (Brevo API, or SMTP) ─────────────────────────────────────────────
BREVO_API_KEY=
WH_BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PredictiX
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PredictiX

# ── Tests only (integration and functional suites) ─────────────────────────
TEST_SUPER_EMAIL=
TEST_SUPER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
