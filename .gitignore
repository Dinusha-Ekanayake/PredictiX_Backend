# `.env` alone only matches that exact name — a `.env.bak` left by an edit, or
# a `.env.production`, was still committable with every secret in it.
.env
.env.*
.venv/

__pycache__/
*.pyc
*.pyo

alembic/

# Transformer/sentence-transformer model weights — too large for GitHub
*.safetensors
scripts/seed_faqs.py

# ONNX asset-summary model artifacts (deployed via Hugging Face, never commit)
onnx_asset_summary*/

# build / runtime logs
*.log
onnx_ticket_summary*/
*__fp32_tmp/
*__int8_tmp/
build_onnx.py
*_quality_test.py
ticket_quality_test.py
.env.example

# Logs / profiling / scratch output
profile.out
*.tmp
admin_summary_tmp.json
temp_model.json
_check_maint_tmp.py
_temp_readme.md
test_out.txt
test_results.json

# Written by scripts/run_functional_tests.py on every run; CI uploads it as a
# build artifact rather than tracking it.
functional_results.json

# Fleet-rebuild intermediate caches (regenerable; hold account id mappings)
scripts/.fleet_cache.pkl
scripts/.superadmin_ids.pkl
scripts/.account_ids.pkl

# Scratch JWTs written while testing endpoints by hand. These are live
# credentials — never commit them.
scripts/.tok*.txt
*.token.txt

# Pre-rebuild database backup — contains auth password hashes, real user
# emails and full table data. Never commit; keep local only.
old-database/

# Local debug scratch scripts
_dbg_*.py
.claude/settings.local.json
CLAUDE.md

# ── Build and runtime artifacts ──────────────────────────────
# Profiler output.
*.out

# Virtualenv. A stray venv/Scripts/python.exe was tracked once.
venv/

# Row-level backups written before a seeding script updates the database. They
# carry reading ids from one environment and cannot be replayed against another.
scripts/backups/

# Local debugging scripts. Two of these carried live Groq keys, so the whole
# directory stays untracked rather than relying on review to catch the next one.
app/chatbot/scratch/

# Exported user reports carry names, emails and phone numbers.
*_report.csv
